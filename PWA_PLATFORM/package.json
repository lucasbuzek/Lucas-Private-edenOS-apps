{
  "name": "@edenos/pwa-platform",
  "version": "0.2.0-dev.2",
  "private": true,
  "type": "module",
  "description": "Reusable independent authenticated PWA staging, deployment preflight and intelligence/authentication adapters for EDENOS applications.",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "validate": "node scripts/validate-manifest.mjs examples/hermes.manifest.json && node scripts/validate-manifest.mjs examples/hermes.cloudflare.closed.manifest.json && node scripts/validate-manifest.mjs examples/cresus.worker.manifest.json && node scripts/validate-fleet.mjs examples/hermes.cloudflare.closed.manifest.json examples/cresus.worker.manifest.json"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "jose": "6.2.12"
  },
  "license": "UNLICENSED",
  "bin": {
    "edenos-pwa": "./scripts/deploy.mjs",
    "edenos-pwa-check": "./scripts/validate-manifest.mjs",
    "edenos-pwa-fleet": "./scripts/validate-fleet.mjs",
    "edenos-pwa-readiness": "./scripts/readiness.mjs",
    "edenos-pwa-namespace": "./scripts/prepare-private-pages.mjs"
  },
  "exports": {
    ".": "./intelligence/core.mjs",
    "./authentication/jwt": "./authentication/jwt.mjs",
    "./intelligence/core": "./intelligence/core.mjs",
    "./intelligence/worker": "./intelligence/worker.mjs",
    "./intelligence/providers": "./intelligence/providers.mjs",
    "./intelligence/openai-compatible": "./intelligence/openai-compatible.mjs",
    "./deployment/hosts": "./deployment/hosts.mjs",
    "./scripts/validate-manifest": "./scripts/validate-manifest.mjs",
    "./scripts/validate-fleet": "./scripts/validate-fleet.mjs",
    "./deployment/verify-target": "./deployment/verify-target.mjs",
    "./scripts/readiness": "./scripts/readiness.mjs",
    "./closed-testing/gateway": "./closed-testing/gateway.mjs",
    "./closed-testing/cloudflare": "./closed-testing/cloudflare.mjs",
    "./closed-testing/d1": "./closed-testing/d1.mjs",
    "./closed-testing/cresus-store": "./closed-testing/cresus-store.mjs",
    "./closed-testing/turnstile": "./closed-testing/turnstile.mjs",
    "./intelligence/qualification": "./intelligence/qualification.mjs",
    "./deployment/private-pages-namespace": "./deployment/private-pages-namespace.mjs",
    "./scripts/prepare-private-pages": "./scripts/prepare-private-pages.mjs",
    "./closed-testing/owner-hub": "./closed-testing/owner-hub.mjs",
    "./software-sharing/backend": "./software-sharing/backend.mjs",
    "./software-sharing/catalog": "./software-sharing/catalog.mjs",
    "./software-sharing/cloudflare": "./software-sharing/cloudflare.mjs",
    "./software-sharing/rate-limit": "./software-sharing/rate-limit.mjs",
    "./software-sharing/downloads": "./software-sharing/downloads.mjs",
    "./environments/private-suites": "./environments/private-suites.mjs",
    "./environments/tenant-gate": "./environments/tenant-gate.mjs"
  },
  "files": [
    "authentication/",
    "deployment/",
    "intelligence/",
    "scripts/",
    "examples/",
    "README.md",
    "closed-testing/",
    "CLOUDFLARE_CLOSED_TEST_RELAUNCH.md",
    "examples/private-pages/",
    "software-sharing/",
    "environments/"
  ]
}
