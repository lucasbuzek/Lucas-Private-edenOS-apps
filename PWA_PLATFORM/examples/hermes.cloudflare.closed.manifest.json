{
  "schemaVersion": 1,
  "app": {
    "id": "hermes",
    "name": "HERMES",
    "version": "1.2.0",
    "standalone": true
  },
  "source": {
    "repository": "https://github.com/lucasbuzek/HERMES",
    "buildCommand": [
      "npm",
      "run",
      "build"
    ],
    "outputDirectory": "dist",
    "projectDirectory": "web",
    "testCommand": [
      "npm",
      "test"
    ],
    "authVerificationCommand": [
      "npm",
      "run",
      "test:hosted-auth"
    ],
    "installCommand": [
      "npm",
      "ci"
    ],
    "hostedAuthEnvironment": {
      "VITE_EDEN_PWA_AUTH_REQUIRED": "true"
    },
    "requiredHostedPublicEnv": [
      "VITE_SUPABASE_URL",
      "VITE_SUPABASE_ANON_KEY"
    ]
  },
  "deployment": {
    "provider": "cloudflare-workers",
    "siteUrl": "",
    "auth": {
      "required": true,
      "provider": "cloudflare-access",
      "publicClientConfigRequired": true,
      "serverSideAuthorizationRequired": true,
      "crossAppSessionsAllowed": false
    },
    "kind": "worker-pwa",
    "targetId": "",
    "workerConfigPath": "wrangler.toml",
    "previewConfigPath": "wrangler.closed-test.toml",
    "accessMode": "closed-testing",
    "closedTesting": {
      "required": true,
      "ownerApprovalRequired": true,
      "turnstileRequired": true,
      "publicWaitlistSeparateFromPrivateApp": true,
      "allAppAssetsProtected": true
    }
  },
  "intelligence": {
    "mode": "shared-core-adapter",
    "endpoint": "",
    "paidApiDependency": false,
    "providers": [
      "gemini-free-tier",
      "local",
      "user-connected",
      "openai-compatible"
    ],
    "fallbackPolicy": "explicit-status-no-silent-provider-switch",
    "defaultProvider": null,
    "requiredCapabilities": [
      "eligibility-screening",
      "consent",
      "research"
    ]
  },
  "data": {
    "domainAuthority": "HERMES",
    "ownership": "app-owned",
    "migration": "preserve-existing-data",
    "crossUserIsolationRequired": true
  }
}
