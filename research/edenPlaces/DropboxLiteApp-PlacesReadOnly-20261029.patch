+    func listFolders() {
+        let remote = settings.remoteName
+        let source = settings.remoteSource
+        let path = browsePath
+        let generation = browseGeneration
+        guard PathSafety.validRemoteName(remote) else { message = "Select a remote first"; return }
+        Task.detached {
+            do {
+                let folders = try SyncCoordinator(engine: RcloneEngine.detected(source: source)).folders(remote: remote, path: path)
+                await MainActor.run {
+                    guard self.browseGeneration == generation,
+                          self.settings.remoteName == remote, self.settings.remoteSource == source,
+                          self.browsePath == path else { return }
+                    self.browseFolders = folders
+                    self.message = "Browse only — no files downloaded"
+                }
+            } catch {
+                await MainActor.run {
+                    guard self.browseGeneration == generation else { return }
+                    self.message = error.localizedDescription
+                }
+            }
+        }
+    }
+    /// Explicit metadata-only read. Does not grant download/sync permissions.
+    func listPlaceFiles() {
+        let remote = settings.remoteName
+        let source = settings.remoteSource
+        let path = browsePath
+        let generation = browseGeneration
+        guard PathSafety.validRemoteName(remote),
+              availableRemotes.contains(where: { $0.name == remote && $0.source == source }) else {
+            message = "Select a configured account to inspect direct file names"
+            return
+        }
+        guard !browsingFiles else { return }
+        browsingFiles = true
+        browseFiles = []
+        Task.detached {
+            do {
+                let engine = try RcloneEngine.detected(source: source)
+                let snapshot = try PlacesReadOnly.inspect(source: source, remote: remote, path: path) {
+                    try engine.execute($0)
+                }
+                await MainActor.run {
+                    guard self.browseGeneration == generation,
+                          self.settings.remoteName == remote, self.settings.remoteSource == source,
+                          self.browsePath == path else { return }
+                    self.browsingFiles = false
+                    self.browseFiles = snapshot.entries.filter { !$0.isDirectory }
+                    self.message = "Metadata only — no files downloaded or folder permissions changed"
+                }
+            } catch {
+                await MainActor.run {
+                    guard self.browseGeneration == generation else { return }
+                    self.browsingFiles = false
+                    self.message = "Read-only file listing unavailable: " + error.localizedDescription
+                }
+            }
+        }
+    }
+    func navigate(_ name: String) {
+        browseGeneration += 1
+        browseFiles = []
+        browsingFiles = false
+        browsePath = browsePath.isEmpty ? name : browsePath + "/" + name
+        listFolders()
+    }
+    func up() {
+        browseGeneration += 1
+        browseFiles = []
+        browsingFiles = false
+        let segments = browsePath.split(separator: "/").dropLast().map(String.init)
+        browsePath = segments.joined(separator: "/")
+        listFolders()
+    }
 
