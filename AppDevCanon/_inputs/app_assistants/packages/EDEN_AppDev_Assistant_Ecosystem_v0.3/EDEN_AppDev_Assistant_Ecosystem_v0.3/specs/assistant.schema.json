{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LUCAS Assistant Specification",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "purpose",
    "inputs",
    "outputs",
    "modes",
    "handoffs",
    "runtime"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "expansion": {
      "type": [
        "string",
        "null"
      ]
    },
    "canonical_status": {
      "enum": [
        "established",
        "partial",
        "provisional"
      ]
    },
    "version": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "modes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "handoffs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "state": {
      "type": "object"
    },
    "security": {
      "type": "object"
    },
    "runtime": {
      "type": "object"
    },
    "lifecycle": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}